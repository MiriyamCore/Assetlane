DATABASE_URL=file:./assetlane.db
PORT=5001
NODE_ENV=development

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5001

# Public API origin — required for bKash callbacks in production
API_PUBLIC_URL=http://localhost:5001

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_secret

# ── Stripe (optional — configure in Admin → Settings → Payments) ────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── bKash (optional — configure in Admin → Settings → Payments) ─────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# ── Docker ────────────────────────────────────────────────────────────────────
# VITE_API_URL is consumed at web image build time when using docker compose.
# See BETA_LAUNCH.md for production values.
